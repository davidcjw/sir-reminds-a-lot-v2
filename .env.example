# Required
TELEGRAM_BOT_TOKEN=

# Database path (default: ./data/bot.db — volume-mounted in Docker)
DATABASE_PATH=./data/bot.db

# Required for access control (SECURITY): comma-separated Telegram user/chat IDs
# allowed to use the bot. Anyone NOT on this list is rejected. If left blank, the
# bot falls back to TELEGRAM_REMINDER_CHAT_ID below; if that is also blank the bot
# FAILS CLOSED and rejects every command. Get your ID by sending /chatid.
# Example: ALLOWED_CHAT_IDS=123456789,987654321
ALLOWED_CHAT_IDS=

# Optional: daily due-date reminders
# Get your chat ID by sending /chatid to the bot
TELEGRAM_REMINDER_CHAT_ID=
TELEGRAM_REMINDER_TIME=09:00
TELEGRAM_REMINDER_TIMEZONE=Asia/Singapore
TELEGRAM_REMINDER_DAYS_BEFORE=3

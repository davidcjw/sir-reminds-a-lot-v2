# Required
TELEGRAM_BOT_TOKEN=

# Database path (default: ./data/bot.db — volume-mounted in Docker)
DATABASE_PATH=./data/bot.db

# Optional: daily due-date reminders
# Get your chat ID by sending /chatid to the bot
TELEGRAM_REMINDER_CHAT_ID=
TELEGRAM_REMINDER_TIME=09:00
TELEGRAM_REMINDER_TIMEZONE=Asia/Singapore
TELEGRAM_REMINDER_DAYS_BEFORE=3
